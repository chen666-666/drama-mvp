# Copy this file to .env, then fill in the values locally:
#   Copy-Item .env.example .env
#
# Never commit .env or paste a real API key into this file.

# Required: API key for the OpenAI-compatible LLM service.
OPENAI_API_KEY=replace_with_your_api_key

# Required: a model ID available from the provider above.
OPENAI_MODEL=gpt-4.1-mini

# Optional: use OpenAI's endpoint, or replace this with another provider's
# documented OpenAI-compatible /v1 endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Public channel or playlist URL used by spider.py. Use only a channel that
# you have confirmed is official and publicly accessible. No login, cookies,
# proxy, CAPTCHA, or access-control bypass is used.
# Example format: https://www.youtube.com/@OfficialChannel/videos
VIDEO_SOURCE_URL=
