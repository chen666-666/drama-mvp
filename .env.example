# Copy this file to .env, then fill in the values locally:
#   Copy-Item .env.example .env
#
# Never commit .env or paste a real API key into this file.

# Optional: only required for AI summaries in the legacy Red Fruit collector.
# The Douyin Top3 workbench needs no model key.
OPENAI_API_KEY=replace_with_your_api_key

# Optional: a model ID for the legacy collector.
OPENAI_MODEL=gpt-4.1-mini

# Optional: use OpenAI's endpoint, or replace this with another provider's
# documented OpenAI-compatible /v1 endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional SQLite file URL. When unset, uses drama.db in the project directory.
# Use a separate file for experiments, e.g. sqlite:///D:/drama-mvp/data/test.db
# DRAMA_DATABASE_URL=

# Website administrator: run python scripts/init_admin.py interactively.
# Private settings are read from data/private/site-auth.env. Environment values
# DRAMA_SITE_ORIGIN, DRAMA_ADMIN_USER, DRAMA_ADMIN_PASSWORD_HASH and
# DRAMA_SESSION_SECRET override that file. Never commit real credentials.
# DOUK_BRIDGE_URL=http://127.0.0.1:5555
# DOUK_HOST=127.0.0.1

# Default local management; docker-compose.yml explicitly selects manage for
# the authenticated online download flow. The separate compose.public.yml uses
# a filtered read-only DB and rejects login/search/download management.
# DRAMA_SITE_MODE=local
# 自动补集：真实来源验证完成后再开启。默认0；网页和补集进程须一致。
DRAMA_EPISODE_DISCOVERY=0
