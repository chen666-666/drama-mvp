# Copy this file to .env, then fill in the values locally:
#   Copy-Item .env.example .env
#
# Never commit .env or paste a real API key into this file.

# Optional: only required for AI summaries in the legacy Red Fruit collector.
# The Douyin Top3 workbench needs no model key.
OPENAI_API_KEY=replace_with_your_api_key

# Optional: a model ID for the legacy collector.
OPENAI_MODEL=gpt-4.1-mini

# Optional: use OpenAI's endpoint, or replace this with another provider's
# documented OpenAI-compatible /v1 endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional SQLite file URL. When unset, uses drama.db in the project directory.
# Use a separate file for experiments, e.g. sqlite:///D:/drama-mvp/data/test.db
# DRAMA_DATABASE_URL=
